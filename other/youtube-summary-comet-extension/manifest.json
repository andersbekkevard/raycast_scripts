{
  "manifest_version": 3,
  "name": "YouTube Executive Summary Bridge",
  "version": "1.0.0",
  "description": "Submits a locally fetched YouTube transcript to ChatGPT without timing-based keyboard automation.",
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
